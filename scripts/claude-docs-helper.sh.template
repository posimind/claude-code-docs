#!/bin/bash
set -euo pipefail

# Claude Code Documentation Helper Script v0.3.3
# This script handles all /{{COMMAND_NAME}} command functionality
# {{COMMAND_NAME}} is substituted by install.sh from $CLAUDE_DOCS_COMMAND_NAME
# Installation path: ~/.claude-code-docs/claude-docs-helper.sh

# Script version
SCRIPT_VERSION="0.3.3"

# Fixed installation path (no need for placeholder replacement)
DOCS_PATH="$HOME/.claude-code-docs"
MANIFEST="$DOCS_PATH/docs/docs_manifest.json"

# How long a check against GitHub stays good for. The mirror is synced from the
# official docs every 3 hours (.github/workflows/update-docs.yml), so looking
# more often than that cannot turn up anything new.
THROTTLE_SECONDS=10800
LAST_CHECK="$DOCS_PATH/.last_check"

# Set when an update needs install.sh re-run but the hook path could not do it
NEEDS_REINSTALL="$DOCS_PATH/.needs_reinstall"

# No colors since they don't work in terminal anyway

# Enhanced sanitize function to prevent command injection
sanitize_input() {
    # Remove ALL shell metacharacters and control characters
    # Only allow alphanumeric, spaces, hyphens, underscores, periods, commas, apostrophes, and question marks
    echo "$1" | sed 's/[^a-zA-Z0-9 _.,'\''?-]//g' | sed 's/  */ /g' | sed 's/^ *//;s/ *$//'
}

# Function to print documentation header
print_doc_header() {
    echo "📚 COMMUNITY MIRROR: https://github.com/posimind/claude-code-docs"
    echo "📖 OFFICIAL DOCS: https://code.claude.com/docs/en"
    echo ""
}


# True when the last check against GitHub is older than the throttle window,
# and when there has never been one. Only ever call this from a condition -
# a bare call would trip set -e on the "not yet expired" answer.
throttle_expired() {
    local last
    [[ -f "$LAST_CHECK" ]] || return 0
    last=$(cat "$LAST_CHECK" 2>/dev/null || echo 0)
    [[ "$last" =~ ^[0-9]+$ ]] || return 0
    (( $(date +%s) - last >= THROTTLE_SECONDS ))
}

# Stamped before the fetch rather than after, so an unreachable GitHub costs
# one timeout per throttle window instead of one on every single call.
mark_checked() {
    date +%s > "$LAST_CHECK" 2>/dev/null || true
}

# Run a git command that talks to the network, with a hard time cap. A firewall
# that silently drops packets would otherwise hang a fetch for minutes - and in
# the hook path that stalls Claude's Read until the hook timeout kills us.
# timeout(1) is always there on Linux; stock macOS lacks it, so fall back to
# curl's low-speed abort, which cuts stalled transfers (though not a hung
# connect - best effort there).
git_net() {
    local cap="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$cap" git "$@"
    else
        GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME="$cap" git "$@"
    fi
}

# Re-run the installer for an update that needed it. The hook path cannot do
# this itself - install.sh re-renders claude-docs-helper.sh, which is the
# script the hook is running inside - so it leaves the marker for whichever
# user-facing command comes next.
run_deferred_install() {
    [[ -f "$NEEDS_REINSTALL" ]] || return 0
    cd "$DOCS_PATH" 2>/dev/null || return 0

    echo "🔧 Updating Claude Code Docs installer..." >&2
    ./install.sh >/dev/null 2>&1 || true
    rm -f "$NEEDS_REINSTALL" 2>/dev/null || true
}

# Function to auto-update docs if needed
#
# Two separate jobs live here:
#   1. git pull - refreshes docs/
#   2. ./install.sh - re-renders what git pull cannot reach: the untracked
#      claude-docs-helper.sh, ~/.claude/commands/ and the settings.json hooks
#
# Pass "skip-installer" from the hook path. install.sh rewrites the very script
# this function runs inside, which is not safe while it is executing.
#
# Returns 2 when GitHub is unreachable. That is a status, not a failure, so
# every caller must keep it away from set -e.
auto_update() {
    local allow_installer=1
    if [[ "${1:-}" == "skip-installer" ]]; then
        allow_installer=0
    fi

    cd "$DOCS_PATH" 2>/dev/null || return 1

    # Get current branch
    local BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")

    mark_checked

    # Quick fetch to check for updates (fast, and capped so it can never hang)
    if ! git_net 15 fetch --quiet origin "$BRANCH" 2>/dev/null; then
        # The branch may just not exist on origin - retry against main. But
        # when we were already on main the retry would hit the same host with
        # the same request, doubling the stall on a dead network: skip it.
        if [[ "$BRANCH" == "main" ]] || ! git_net 15 fetch --quiet origin main 2>/dev/null; then
            # Fetch failed - can't sync
            return 2
        fi
        # Use main branch for comparison
        BRANCH="main"
    fi

    local BEFORE=$(git rev-parse HEAD 2>/dev/null)
    local REMOTE=$(git rev-parse origin/"$BRANCH" 2>/dev/null)

    # Check if we're behind remote (important: not ahead)
    local BEHIND=$(git rev-list HEAD..origin/"$BRANCH" --count 2>/dev/null || echo "0")

    if [[ "$BEFORE" == "$REMOTE" ]] || [[ "$BEHIND" -eq 0 ]]; then
        return 0  # Already up-to-date, or ahead of origin
    fi

    # We're behind - safe to pull. Capped well under the 60s hook timeout so a
    # killed hook can never leave a half-finished pull (and a stale git lock)
    echo "🔄 Updating documentation..." >&2
    git_net 30 pull --quiet origin "$BRANCH" 2>&1 | grep -v "Merge made by" || true

    # Re-installing only matters when the pull changed something the installed
    # copy is rendered from. Nearly every update touches docs/ alone.
    if ! git diff --name-only "$BEFORE" HEAD 2>/dev/null \
        | grep -qE '^(install\.sh|scripts/claude-docs-helper\.sh\.template)$'; then
        return 0
    fi

    # Record it either way; the hook path leaves it for the next command to run
    touch "$NEEDS_REINSTALL" 2>/dev/null || true
    if [[ $allow_installer -eq 1 ]]; then
        run_deferred_install
    fi

    return 0  # Success (either updated or already up-to-date)
}

# Function to show documentation sync status
show_freshness() {
    print_doc_header
    
    # Read manifest
    if [[ ! -f "$MANIFEST" ]]; then
        echo "❌ Error: Documentation not found at ~/.claude-code-docs"
        echo "Please reinstall with:"
        echo "curl -fsSL https://raw.githubusercontent.com/posimind/claude-code-docs/main/install.sh | bash"
        exit 1
    fi
    
    # Try to sync with GitHub. Deliberately not throttled: -t means the user
    # asked about freshness itself, so the answer has to be current.
    local sync_status=0
    auto_update || sync_status=$?
    
    if [[ $sync_status -eq 2 ]]; then
        echo "⚠️  Could not sync with GitHub (using local cache)"
        echo "Check your internet connection or GitHub access"
    else
        # Check if we're ahead or behind
        cd "$DOCS_PATH" 2>/dev/null || exit 1
        local BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
        # If current branch doesn't exist on origin, compare to main
        local COMPARE_BRANCH="$BRANCH"
        if ! git rev-parse --verify origin/"$BRANCH" >/dev/null 2>&1; then
            COMPARE_BRANCH="main"
        fi
        local AHEAD=$(git rev-list origin/"$COMPARE_BRANCH"..HEAD --count 2>/dev/null || echo "0")
        local BEHIND=$(git rev-list HEAD..origin/"$COMPARE_BRANCH" --count 2>/dev/null || echo "0")
        
        if [[ "$AHEAD" -gt 0 ]]; then
            echo "⚠️  Local version is ahead of GitHub by $AHEAD commit(s)"
        elif [[ "$BEHIND" -gt 0 ]]; then
            echo "⚠️  Local version is behind GitHub by $BEHIND commit(s)"
        else
            echo "✅ You have the latest documentation"
        fi
    fi
    
    # Show current branch and version
    cd "$DOCS_PATH" 2>/dev/null || exit 1
    local BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    echo "📍 Branch: ${BRANCH}"
    echo "📦 Version: ${SCRIPT_VERSION}"
}

# Function to read documentation
read_doc() {
    local topic=$(sanitize_input "$1")
    
    # Strip .md extension if user included it (they're being helpful!)
    topic="${topic%.md}"
    
    local doc_path="$DOCS_PATH/docs/${topic}.md"
    
    if [[ -f "$doc_path" ]]; then
        print_doc_header
        
        # Quick check if we're up to date (0.37s)
        cd "$DOCS_PATH" 2>/dev/null || exit 1
        local BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
        local VERSION=$SCRIPT_VERSION
        
        # Do the fetch to check status, at most once per throttle window.
        # Inside the window, compare against the ref we already fetched.
        local COMPARE_BRANCH="$BRANCH"
        if throttle_expired; then
            mark_checked
            if ! git_net 15 fetch --quiet origin "$BRANCH" 2>/dev/null; then
                # Try main if current branch doesn't exist on origin - but not
                # when main is what just failed; retrying it only doubles the stall
                if [[ "$BRANCH" != "main" ]] && git_net 15 fetch --quiet origin main 2>/dev/null; then
                    COMPARE_BRANCH="main"
                else
                    echo "⚠️  Could not check GitHub for updates - using cached docs (v$VERSION, $BRANCH)"
                    echo ""
                    cat "$doc_path"
                    echo ""
                    echo "📖 Official page: https://code.claude.com/docs/en/$topic"
                    return
                fi
            fi
        elif ! git rev-parse --verify origin/"$COMPARE_BRANCH" >/dev/null 2>&1; then
            COMPARE_BRANCH="main"
        fi
        
        local LOCAL=$(git rev-parse HEAD 2>/dev/null)
        local REMOTE=$(git rev-parse origin/"$COMPARE_BRANCH" 2>/dev/null)
        local BEHIND=$(git rev-list HEAD..origin/"$COMPARE_BRANCH" --count 2>/dev/null || echo "0")
        
        if [[ "$LOCAL" != "$REMOTE" ]] && [[ "$BEHIND" -gt 0 ]]; then
            # We're behind - safe to update
            echo "🔄 Updating to latest documentation..."
            git_net 30 pull --quiet origin "$COMPARE_BRANCH" 2>&1 | grep -v "Merge made by" || true

            # Re-install only when the pull changed what the installed copy is
            # rendered from - $LOCAL is the commit we were on before the pull
            if git diff --name-only "$LOCAL" HEAD 2>/dev/null \
                | grep -qE '^(install\.sh|scripts/claude-docs-helper\.sh\.template)$'; then
                touch "$NEEDS_REINSTALL" 2>/dev/null || true
                run_deferred_install
            fi
            echo "✅ Updated to latest (v$VERSION, $BRANCH)"
        else
            local AHEAD=$(git rev-list origin/"$COMPARE_BRANCH"..HEAD --count 2>/dev/null || echo "0")
            if [[ "$AHEAD" -gt 0 ]]; then
                echo "⚠️  Using local development version (v$VERSION, $BRANCH, +$AHEAD commits)"
            else
                echo "✅ You have the latest docs (v$VERSION, $BRANCH)"
            fi
        fi
        echo ""
        
        cat "$doc_path"
        echo ""
        if [[ "$topic" == "changelog" ]]; then
            echo "📖 Official source: https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md"
        else
            echo "📖 Official page: https://code.claude.com/docs/en/$topic"
        fi
    else
        # Always show search interface - never error messages
        print_doc_header
        echo "🔍 Searching for: $topic"
        echo ""
        
        # Try to extract keywords from the topic
        local keywords=$(echo "$topic" | grep -o '[a-zA-Z0-9_-]\+' | grep -v -E '^(tell|me|about|explain|what|is|are|how|do|to|show|find|search|the|for|in)$' | tr '\n' ' ')
        
        if [[ -n "$keywords" ]]; then
            # Search for matching topics - escape the pattern
            local escaped_keywords=$(echo "$keywords" | sed 's/[[\.*^$()+?{|]/\\&/g')
            local matches=$(ls "$DOCS_PATH/docs" | grep '\.md$' | sed 's/\.md$//' | grep -i -E "$(echo "$escaped_keywords" | tr ' ' '|')" | sort)
            
            if [[ -n "$matches" ]]; then
                echo "Found these related topics:"
                echo "$matches" | sed 's/^/  • /' 
                echo ""
                echo "Try: /{{COMMAND_NAME}} <topic> to read a specific document"
            else
                echo "No exact matches found. Here are all available topics:"
                ls "$DOCS_PATH/docs" | grep '\.md$' | sed 's/\.md$//' | sort | column -c 80
            fi
        else
            echo "Available topics:"
            ls "$DOCS_PATH/docs" | grep '\.md$' | sed 's/\.md$//' | sort | column -c 80
        fi
        echo ""
        echo "💡 Tip: Use grep to search across all docs: cd ~/.claude-code-docs && grep -r 'search term' docs/"
    fi
}

# Function to list available documentation
list_docs() {
    print_doc_header
    
    # Auto-update to ensure fresh list. Throttled, and an offline run still
    # lists whatever is already mirrored.
    if throttle_expired; then
        auto_update || true
    fi

    echo "Available documentation topics:"
    echo ""
    ls "$DOCS_PATH/docs" | grep '\.md$' | sed 's/\.md$//' | sort | column -c 80
    echo ""
    echo "Usage: /{{COMMAND_NAME}} <topic> or /{{COMMAND_NAME}} -t to check freshness"
}

# PreToolUse hook for Read: keep the mirror fresh when Claude reads from it.
# Reads the hook payload on stdin and always exits 0 - exit 2 from a PreToolUse
# hook blocks the tool call, so an unreachable GitHub must never be allowed to
# stop Claude from reading a file.
hook_check() {
    local input file_path

    input=$(cat 2>/dev/null || true)
    file_path=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null || true)

    # Reads outside the mirror are none of our business, and must not be made
    # to wait on a git fetch
    case "$file_path" in
        "$DOCS_PATH"/*) ;;
        *) exit 0 ;;
    esac

    if throttle_expired; then
        auto_update skip-installer || true
    fi

    exit 0
}

# Function to show what's new (simplified version)
whats_new() {
    # Temporarily disable strict error handling for this function
    set +e
    
    print_doc_header
    
    # Auto-update first (synchronous - we need latest git history). Throttled
    # like every automatic sync: within the window the history is at most
    # 3 hours old, which is the mirror's own update cadence. This also keeps
    # "-t whats new" from fetching twice - show_freshness just synced.
    if throttle_expired; then
        auto_update || true  # Don't fail if auto-update fails
    fi
    
    cd "$DOCS_PATH" 2>/dev/null || {
        echo "❌ Error: Could not access documentation directory"
        return 1
    }
    
    echo "📚 Recent documentation updates:"
    echo ""
    
    # Get recent commits (simplified - just show all doc commits)
    local count=0
    
    # Show recent commits
    while IFS= read -r commit_line && [[ $count -lt 5 ]]; do
        local hash=$(echo "$commit_line" | cut -d' ' -f1)
        local date=$(git show -s --format=%cr "$hash" 2>/dev/null || echo "unknown")
        
        echo "• $date:"
        echo "  📎 https://github.com/posimind/claude-code-docs/commit/$hash"
        
        # Show which docs changed
        local changed_docs=$(git diff-tree --no-commit-id --name-only -r "$hash" -- docs/*.md 2>/dev/null | sed 's|docs/||' | sed 's|\.md$||' | head -5)
        if [[ -n "$changed_docs" ]]; then
            echo "$changed_docs" | while read -r doc; do
                [[ -n "$doc" ]] && echo "  📄 $doc: https://code.claude.com/docs/en/$doc"
            done
        fi
        echo ""
        ((count++))
    done < <(git log --oneline -10 -- docs/*.md 2>/dev/null | grep -v "Merge" || true)
    
    if [[ $count -eq 0 ]]; then
        echo "No recent documentation updates found."
        echo ""
    fi
    
    echo "📎 Full changelog: https://github.com/posimind/claude-code-docs/commits/main/docs"
    echo "📚 COMMUNITY MIRROR - NOT AFFILIATED WITH ANTHROPIC"
    
    # Re-enable strict error handling
    set -e
    
    # Ensure we always exit successfully
    return 0
}

# Function for uninstall
uninstall() {
    print_doc_header
    echo "To uninstall Claude Code Documentation Mirror"
    echo "==========================================="
    echo ""
    
    echo "This will remove:"
    echo "  • The /{{COMMAND_NAME}} command from ~/.claude/commands/{{COMMAND_NAME}}.md"
    echo "  • The auto-update hook from ~/.claude/settings.json"
    echo "  • The installation directory ~/.claude-code-docs"
    echo ""
    
    echo "Run this command in your terminal:"
    echo ""
    echo "  ~/.claude-code-docs/uninstall.sh"
    echo ""
    echo "Or to skip confirmation:"
    echo "  echo 'y' | ~/.claude-code-docs/uninstall.sh"
    echo ""
}

# Map an official docs URL to a file in the local mirror.
# https://code.claude.com/docs/en/agent-sdk/python -> agent-sdk__python.md
# Prints the filename, or nothing when the page is not mirrored.
url_to_local_file() {
    local url="$1"
    local slug candidate

    # Drop query string, fragment, a trailing .md and any trailing slash
    url="${url%%\?*}"
    url="${url%%#*}"
    url="${url%.md}"
    url="${url%/}"

    # Exact match against the manifest is authoritative
    if [[ -f "$MANIFEST" ]]; then
        candidate=$(jq -r --arg u "$url" \
            'first(.files | to_entries[] | select(.value.original_url == $u) | .key) // empty' \
            "$MANIFEST" 2>/dev/null || true)
        if [[ -n "$candidate" && -f "$DOCS_PATH/docs/$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    fi

    # Fall back to the naming convention for pages added since the last sync
    slug="${url#*://}"
    slug="${slug#*/docs/en/}"
    if [[ "$slug" != "$url" && -n "$slug" ]]; then
        candidate="${slug//\//__}.md"
        if [[ -f "$DOCS_PATH/docs/$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    fi

    return 0
}

# PreToolUse hook for WebFetch: send official docs URLs to the local mirror.
# Reads the hook payload on stdin and always exits 0 - the decision travels
# in the JSON body, not the exit code.
webfetch_guard() {
    local input url local_file reason

    input=$(cat)
    url=$(printf '%s' "$input" | jq -r '.tool_input.url // empty' 2>/dev/null || true)

    # Anything that is not the official docs site is none of our business
    case "$url" in
        http://code.claude.com/*|https://code.claude.com/*) ;;
        *) exit 0 ;;
    esac

    local_file=$(url_to_local_file "$url")

    if [[ -n "$local_file" ]]; then
        reason="This page is mirrored locally and code.claude.com is not reachable from this network. Read $DOCS_PATH/docs/$local_file instead."
    else
        reason="code.claude.com is not reachable from this network, and no mirrored page matches $url. Search the local mirror instead: ls $DOCS_PATH/docs/ for the topic list, or grep -ril '<keyword>' $DOCS_PATH/docs/. Page-to-file mapping lives in $MANIFEST."
    fi

    jq -n --arg reason "$reason" '{
        hookSpecificOutput: {
            hookEventName: "PreToolUse",
            permissionDecision: "deny",
            permissionDecisionReason: $reason
        }
    }'
    exit 0
}

# SubagentStart hook: tell the subagent the mirror exists before it reaches
# for WebFetch. Reads and discards the hook payload, always exits 0.
subagent_context() {
    local topic_count context

    cat >/dev/null 2>&1 || true

    topic_count=$(ls "$DOCS_PATH/docs" 2>/dev/null | grep -c '\.md$' || echo "0")

    context="The Claude Code documentation is mirrored locally at $DOCS_PATH/docs/ ($topic_count pages, synced from https://code.claude.com/docs/en/). code.claude.com is NOT reachable from this network, so answer from the mirror: Read $DOCS_PATH/docs/<topic>.md, or grep -ril '<keyword>' $DOCS_PATH/docs/ to find the right page. Nested pages flatten their path with a double underscore, so /docs/en/agent-sdk/python is agent-sdk__python.md. $MANIFEST maps every file to its original URL. Cite the official URL in your answer, but do not fetch it."

    jq -n --arg ctx "$context" '{
        hookSpecificOutput: {
            hookEventName: "SubagentStart",
            additionalContext: $ctx
        }
    }'
    exit 0
}

# Store original arguments for flag checking
FULL_ARGS="$*"

# Hook entry points run inside the very script install.sh would replace, so they
# never trigger it. Every other entry point is user-facing and is free to pick
# up an install the hook path had to defer - except uninstall, where setting the
# hooks back up moments before the user removes them would be absurd.
case "${1:-}" in
    hook-check|webfetch-guard|subagent-context|uninstall) ;;
    *) run_deferred_install ;;
esac

# Check if arguments start with -t flag (before sanitization)
if [[ "$FULL_ARGS" =~ ^-t([[:space:]]+(.*))?$ ]]; then
    show_freshness
    remaining_args="${BASH_REMATCH[2]}"
    if [[ "$remaining_args" =~ ^what.?s?[[:space:]]?new.*$ ]]; then
        echo ""
        whats_new
    elif [[ -n "$remaining_args" ]]; then
        echo ""
        read_doc "$(sanitize_input "$remaining_args")"
    fi
    exit 0
elif [[ "$FULL_ARGS" =~ ^--check([[:space:]]+(.*))?$ ]]; then
    show_freshness
    remaining_args="${BASH_REMATCH[2]}"
    if [[ "$remaining_args" =~ ^what.?s?[[:space:]]?new.*$ ]]; then
        echo ""
        whats_new
    elif [[ -n "$remaining_args" ]]; then
        echo ""
        read_doc "$(sanitize_input "$remaining_args")"
    fi
    exit 0
fi

# Main command handling
case "${1:-}" in
    -t|--check)
        show_freshness
        # Check if remaining args form "what's new"
        shift
        remaining_args="$*"
        if [[ "$remaining_args" =~ ^what.?s?[[:space:]]?new.*$ ]]; then
            echo ""
            whats_new
        elif [[ -n "$remaining_args" ]]; then
            echo ""
            read_doc "$(sanitize_input "$remaining_args")"
        fi
        ;;
    hook-check)
        hook_check
        ;;
    webfetch-guard)
        webfetch_guard
        ;;
    subagent-context)
        subagent_context
        ;;
    uninstall)
        uninstall
        ;;
    whats-new|whats|what)
        # Handle various forms of "what's new"
        shift
        remaining="$*"
        if [[ "$remaining" =~ new ]] || [[ "$FULL_ARGS" =~ what.*new ]]; then
            whats_new
        else
            # Just "what" without "new" - treat as doc lookup
            read_doc "$(sanitize_input "$1")"
        fi
        ;;
    "")
        list_docs
        ;;
    *)
        # Check if the full arguments match "what's new" pattern
        if [[ "$FULL_ARGS" =~ what.*new ]]; then
            whats_new
        else
            # Default: read documentation
            read_doc "$(sanitize_input "$1")"
        fi
        ;;
esac

# Ensure script always exits successfully
exit 0